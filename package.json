{
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@jyooi/pi-ask-user-question": "0.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "pi-memory": "0.4.2",
    "pi-web-access": "0.32.0",
    "tsx": "4.23.15",
    "typebox": "1.3.34",
    "typescript": "7.0.2"
  },
  "name": "bbui-phone-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "desktop:build": "node scripts/desktop/build.mjs",
    "desktop": "electron .desktop/app",
    "desktop:package": "node scripts/desktop/package.mjs",
    "test:desktop": "tsx --test tests/desktop.test.mjs tests/desktop-control.test.mjs tests/desktop-readiness.test.mjs tests/desktop-queue.test.mjs tests/model-settings.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:pi": "tsx --test tests/pi.test.ts",
    "test:session-title": "node --test pi/android/session-title.test.mjs pi/android/sessions.test.mjs",
    "test:task-state": "tsx --test tests/task-state.test.ts",
    "test:phone-skill": "node scripts/android-runtime/bundle-tools.mjs && tsx --test tests/phone-skill.test.ts tests/phone-skill-protocols.test.mjs",
    "test:calendar": "node scripts/android-runtime/bundle-tools.mjs && tsx --test tests/calendar-protocols.test.mjs",
    "test:nongui": "node scripts/android-runtime/bundle-tools.mjs && tsx --test tests/non-gui-protocols.test.mjs",
    "test:android-bridge": "tsx --test pi/android/bridge.test.ts",
    "test:android-runtime-config": "node --test pi/android/runtime-config.test.mjs pi/android/rpc-timing.test.mjs pi/android/request-budget.test.mjs pi/android/model-probe.test.mjs",
    "test:screenshot-context": "tsx --test tests/screenshot-context.test.ts",
    "test:protocols": "node --test pi/android/protocols.test.mjs",
    "test:android-chat": "npm --prefix android/chat-ui test",
    "android:prepare": "node scripts/android-runtime/prepare.mjs",
    "android:test-payload": "node scripts/android-runtime/test-payload.mjs",
    "android:build": "powershell -NoProfile -File scripts/build-android.ps1",
    "test:agent-tools": "node scripts/android-runtime/bundle-tools.mjs && node --test pi/android/agent-tools.test.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.0",
    "@electron/packager": "20.3.0",
    "@types/node": "26.6.2",
    "electron": "44.4.5",
    "esbuild": "0.25.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhang3c3c33c/BigBirdUI.git"
  },
  "homepage": "https://github.com/zhang3c3c33c/BigBirdUI#readme",
  "bugs": {
    "url": "https://github.com/zhang3c3c33c/BigBirdUI/issues"
  }
}
